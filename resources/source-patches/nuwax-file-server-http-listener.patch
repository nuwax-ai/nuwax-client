new file mode 100644
--- /dev/null
+++ b/src/utils/httpListener.js
@@ -0,0 +1,19 @@
+import http from "node:http";
+
+/**
+ * 仅在真实 listening 事件后通知成功，避免 Express 5 将绑定失败传给成功回调。
+ * host 未提供时保留独立 CLI 的绑定行为；桌面宿主显式传入回环地址。
+ */
+export function listenHttp(app, { port, host, onReady, onError }) {
+  const server = http.createServer(app);
+  server.once("error", onError);
+  server.once("listening", () => {
+    Promise.resolve(onReady(server.address())).catch(onError);
+  });
+  try {
+    server.listen({ port, ...(host ? { host } : {}) });
+  } catch (error) {
+    onError(error);
+  }
+  return server;
+}
