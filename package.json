{
  "name": "@nuwax-ai/nuwax-client",
  "version": "1.0.0",
  "private": true,
  "description": "女娲Nuwax 商业版 Electron 客户端 —— 产品壳（功能模块在 nuwa-electron-shell/，已并入本仓直接维护，不再是子模块）",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "shell:exec": "node scripts/run-shell.cjs",
    "host-bridge:sync": "node scripts/sync-host-bridge-contract.mjs",
    "host-bridge:check": "node scripts/sync-host-bridge-contract.mjs --check",
    "test:commercial": "node scripts/run-shell.cjs --no-env -- npm run test:electron",
    "test:scripts": "node --test scripts/*.test.mjs",
    "diagnostics:export": "node scripts/export-diagnostics.mjs",
    "frontend:build": "node scripts/client/cli.mjs frontend:build",
    "dev": "node scripts/client/cli.mjs dev",
    "pack": "node scripts/client/cli.mjs pack",
    "sub:update": "node scripts/client/cli.mjs sub:update",
    "release": "node scripts/client/cli.mjs release",
    "sign:win": "node scripts/client/forward.mjs sign:win",
    "verify:sign:win": "node scripts/client/forward.mjs verify:sign:win",
    "sync:oss": "node scripts/client/forward.mjs sync:oss",
    "doctor": "node scripts/client/cli.mjs doctor",
    "setup": "node scripts/client/cli.mjs setup",
    "prepare:capture": "node scripts/prepare-capture-resources.mjs",
    "prepare:terminal-compat": "node scripts/prepare-terminal-compat.mjs"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "json-bigint": "1.0.0",
    "mime-types": "3.0.1",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/json-bigint": "1.0.4",
    "@types/mime-types": "3.0.1",
    "@types/ws": "8.18.1",
    "node-api-headers": "1.9.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "22.19.15"
    }
  }
}
