{
  "private": true,
  "scripts": {
    "build:agent-kit": "node scripts/build-agent-kit.js",
    "test:electron": "cd crates/agent-electron-client && npm run test:run",
    "test:electron:scripts": "cd crates/agent-electron-client && npm run test:scripts",
    "update:harness": "pnpm -C crates/agent-kit update @nuwax-ai/nuwax-harness-acp-ts --ignore-workspace && pnpm -r update @nuwax-ai/nuwax-harness-acp-ts"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "overrides": {
      "@nuwax-ai/agent-kit": "file:crates/agent-kit",
      "protobufjs": ">=7.5.6",
      "@protobufjs/utf8": ">=1.1.1",
      "tar": ">=7.5.8",
      "picomatch": ">=4.0.4",
      "fast-uri": ">=2.4.1",
      "xmldom": ">=0.6.0",
      "i18next-http-backend": ">=3.0.5",
      "path-to-regexp": ">=0.7.3",
      "flatted": ">=0.2.0",
      "axios": ">=1.8.4",
      "basic-ftp": ">=5.2.1",
      "fast-xml-parser": ">=4.8.1",
      "lodash": ">=4.17.31"
    },
    "onlyBuiltDependencies": [
      "@nuwax-ai/nuwax-harness",
      "electron",
      "better-sqlite3",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
