{
  "name": "@nuwax-ai/agent-kit",
  "version": "0.4.0",
  "packageManager": "pnpm@9.15.5",
  "description": "Internal ACP, engine resolution and permission primitives for the Nuwax desktop client.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "pretest": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^0.26.0 || ^1.2.1",
    "@nuwax-ai/nuwax-harness-acp-ts": "^1.2.22"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nuwax-ai/nuwax-harness",
      "esbuild"
    ]
  },
  "private": true
}
