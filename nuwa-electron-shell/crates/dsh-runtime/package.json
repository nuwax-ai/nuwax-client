    "@deepseek-ai/dsh-web-app": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill-office": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-workspace-dependencies": "0.2.1-rc.5",
    "@deepseek-ai/libreoffice-kit": "0.1.5",
    "ds-bot": "0.2.7",
    "extract-zip": "2.0.1",
    "papaparse": "5.5.3",
    "pnpm": "11.7.0",
    "tar": "7.5.22",
    "ws": "8.18.3",
    "yaml": "2.9.1",
    "@nuwax-ai/dsh-nuwax-bridge": "file:./bridge",
    "playwright": "1.61.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5"
