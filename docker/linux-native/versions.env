# Single source of truth for the Linux native build image.
#
# Every version and checksum the image depends on lives here. Bump a value and
# rebuild; nothing else in the repo hard-codes these.
#
# Checksum sources:
#   node        — verified against nodejs.org/dist/<v>/SHASUMS256.txt
#   rustup-init — verified against static.rust-lang.org/.../rustup-init.sha256
#   python      — computed from the pinned release asset; python-build-standalone
#                 publishes no checksum file
#   git         — computed from the pinned tarball on kernel.org
#   nasm        — computed from the pinned tarball on nasm.us (no checksum file published)
#   base image  — `docker buildx imagetools inspect public.ecr.aws/docker/library/debian:10`;
#                 the digest is the manifest list, i.e. the line after "Digest:"

# Base image: Debian 10 buster, glibc 2.28. Pinned by the digest of the
# multi-arch manifest list, so the same value fixes both amd64 and arm64 and
# the tag cannot be repointed underneath us.
DEBIAN_BASE_IMAGE=public.ecr.aws/docker/library/debian@sha256:58ce6f1271ae1c8a2006ff7d3e54e9874d839f573d8009c20154ad0f2fb0a225

# Node — only used to drive node-gyp and the build scripts inside the image.
# Official binaries need exactly glibc 2.28, which is why buster is the floor.
NODE_VERSION=24.14.0
NODE_SHA256_X64=41cd79bb7877c81605a9e68ec4c91547774f46a40c67a17e34d7179ef11729df
NODE_SHA256_ARM64=e7adfca03d9173276114a6f2219df1a7d25e1bfd6bbd771d3f839118a2053094

# Python — node-gyp 13 needs >= 3.8 (gyp uses the walrus operator); buster ships 3.7.
PYTHON_VERSION=3.12.16
PYTHON_BUILD=20261123
PYTHON_SHA256_X64=386028a53cceb3be3c1ef8d8828f707d7d3aab67631049f9806e0fb3665a40c8
PYTHON_SHA256_ARM64=8f6648cfd81f96d72fa8a00f1e5a8c460169728cf34969a9b1732ab244e9e99f

# Git — buster's own 2.20.1 cannot run build-helper.sh: it rejects
# `fetch --filter=blob:none` and has no `sparse-checkout` subcommand.
GIT_VERSION=2.47.1
GIT_SHA256=f3d8f9bb23ae392374e91cd9d395970dabc5b9c5ee72f39884613cd84a6ed310

# nasm — buster's own 2.14 cannot assemble FFmpeg 8's x86 sources: ALLOC_STACK in
# libavutil/x86/x86inc.asm fails ("expecting `)'"), so the capture build dies on x64.
# arm64 has no x86 assembly and never hits it. Not in buster-backports; built from source.
NASM_VERSION=2.16.03
NASM_SHA256=1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148

# Rust — must match the toolchain pinned by .github/actions/native-build-cache
# and by the locked cua workspace. rustup-init is taken from the versioned
# archive path, never from the rolling sh.rustup.rs script.
RUSTUP_VERSION=1.29.3
RUSTUP_SHA256_X64=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
RUSTUP_SHA256_ARM64=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282
RUST_TOOLCHAIN=1.97.1
RUST_COMPONENTS=rustfmt

# The glibc floor this image exists to guarantee. The release gate reads this.
GLIBC_FLOOR=2.28
