+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub(crate) struct Context {
+    task_id: String,
+    epoch: u64,
+    binding_id: String,
+    pid: i32,
+    #[serde(default)]
+    host_pid: i32,
+    window_id: u64,
+    mode: String,
+}
+#[derive(Clone, Debug, Serialize)]
+struct Window {
+    valid: bool,
+    foreground: bool,
+    visible: bool,
+    stamp: String,
+    bounds: Value,
+}
+struct Task {
+    context: Context,
+    stamp: String,
+    revoked: bool,
+    in_flight: usize,
+    cursor_id: Option<String>,
+}
+#[derive(Default)]
+struct Registry {
+    tasks: HashMap<String, Task>,
+}
+fn registry() -> &'static Mutex<Registry> {
+    static REGISTRY: OnceLock<Mutex<Registry>> = OnceLock::new();
+    REGISTRY.get_or_init(|| Mutex::new(Registry::default()))
+}
+fn process_locks() -> &'static Mutex<HashMap<i32, Arc<tokio::sync::Mutex<()>>>> {
+    static LOCKS: OnceLock<Mutex<HashMap<i32, Arc<tokio::sync::Mutex<()>>>>> = OnceLock::new();
+    LOCKS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+pub(crate) fn enabled() -> bool {
+    cfg!(any(target_os = "macos", target_os = "windows"))
+        && std::env::var("CUA_DRIVER_NUWAX_WINDOW_TASKS").as_deref() == Ok("1")
+}
+fn context(value: Value) -> Result<Context, &'static str> {
+    let c: Context = serde_json::from_value(value).map_err(|_| "task_context_required")?;
+    if c.task_id.len() != 36
+        || c.binding_id.len() != 36
+        || c.epoch == 0
+        || c.pid <= 0
+        || c.window_id == 0
+        || !matches!(c.mode.as_str(), "background" | "foreground")
+    {
+        return Err("invalid_task_context");
+    }
+    Ok(c)
+}
+fn unavailable() -> Window {
+    Window {
+        valid: false,
+        foreground: false,
+        visible: false,
+        stamp: String::new(),
+        bounds: Value::Null,
+    }
+}
+fn status(task: &Task) -> Value {
+    json!({ "task_id": task.context.task_id, "epoch": task.context.epoch,
+        "drained": task.in_flight == 0, "revoked": task.revoked })
+}
+impl Registry {
+    fn bind(&mut self, c: Context, w: &Window) -> Result<Value, &'static str> {
+        if !w.valid {
+            return Err("target_closed");
+        }
+        if let Some(old) = self.tasks.get(&c.task_id) {
+            if c.epoch < old.context.epoch || (c.epoch == old.context.epoch && old.revoked) {
+                return Err("stale_task_epoch");
+            }
+            if c.binding_id == old.context.binding_id
+                && (old.stamp != w.stamp
+                    || c.pid != old.context.pid
+                    || c.window_id != old.context.window_id)
+            {
+                return Err("target_identity_changed");
+            }
+            if c != old.context && old.in_flight != 0 {
+                return Err("handoff_pending");
+            }
+            if c == old.context {
+                return Ok(status(old));
+            }
+        }
+        if self.tasks.values().any(|old| {
+            old.context.task_id != c.task_id
+                && old.context.pid == c.pid
+                && old.context.window_id == c.window_id
+                && (!old.revoked || old.in_flight != 0)
+        }) {
+            return Err("window_busy");
+        }
+        if self.tasks.values().any(|old| {
+            old.context.task_id != c.task_id
+                && (!old.revoked || old.in_flight != 0)
+                && (c.mode == "foreground" || old.context.mode == "foreground")
+        }) {
+            return Err("desktop_busy");
+        }
+        if self.tasks.len() >= 256 && !self.tasks.contains_key(&c.task_id) {
+            return Err("task_capacity");
+        }
+        let task = Task {
+            context: c.clone(),
+            stamp: w.stamp.clone(),
+            revoked: false,
+            in_flight: 0,
+            cursor_id: None,
+        };
+        let result = status(&task);
+        self.tasks.insert(c.task_id, task);
+        Ok(result)
+    }
+    fn revoke(&mut self, c: &Context) -> Result<Value, &'static str> {
+        let Some(task) = self.tasks.get_mut(&c.task_id) else {
+            return Ok(json!({ "task_id": c.task_id, "drained": true, "revoked": true }));
+        };
+        if c.epoch < task.context.epoch {
+            return Err("stale_task_epoch");
+        }
+        task.context.epoch = c.epoch;
+        task.revoked = true;
+        Ok(status(task))
+    }
+    fn admit(&mut self, c: &Context, w: &Window) -> Result<(), &'static str> {
+        let task = self.tasks.get_mut(&c.task_id).ok_or("task_not_bound")?;
+        if task.revoked || task.context != *c {
+            return Err("stale_task_epoch");
+        }
+        if !w.valid || task.stamp != w.stamp {
+            task.revoked = true;
+            return Err("target_identity_changed");
+        }
+        if c.mode == "background" && w.foreground {
+            task.revoked = true;
+            return Err("user_in_control");
+        }
+        task.in_flight += 1;
+        Ok(())
+    }
+}
+pub(crate) fn control(req: &DaemonRequest) -> DaemonResponse {
+    if !enabled() {
+        return DaemonResponse::err("window_tasks_unavailable", 77);
+    }
+    let name = req.name.as_deref().unwrap_or("");
+    if name == "states" {
+        let contexts: Vec<Context> = registry()
+            .lock()
+            .unwrap()
+            .tasks
+            .values()
+            .map(|t| t.context.clone())
+            .collect();
+        let states: Vec<Value> = contexts.iter().map(|c| {
+            let mut w = probe(c.pid, c.window_id, c.host_pid);
+            let (stamp, color) = {
+                let r = registry().lock().unwrap();
+                let task = r.tasks.get(&c.task_id);
+                (task.map(|t| t.stamp.clone()), task.and_then(|t| t.cursor_id.as_deref()).map(cursor_overlay::session_fill_hex))
+            };
+            if stamp.as_deref() != Some(w.stamp.as_str()) { w.valid = false; }
+            json!({ "task_id": c.task_id, "binding_id": c.binding_id, "epoch": c.epoch, "window": w, "color": color })
+        }).collect();
+        return DaemonResponse::ok(json!({ "tasks": states }));
+    }
+    let c = match context(req.args.clone().unwrap_or(Value::Null)) {
+        Ok(c) => c,
+        Err(error) => return DaemonResponse::err(error, 64),
+    };
+    let mut result = match name {
+        "bind" => {
+            let w = probe(c.pid, c.window_id, c.host_pid);
+            registry().lock().unwrap().bind(c.clone(), &w)
+        }
+        "revoke" => registry().lock().unwrap().revoke(&c),
+        "window" => {
+            let mut w = probe(c.pid, c.window_id, c.host_pid);
+            if registry()
+                .lock()
+                .unwrap()
+                .tasks
+                .get(&c.task_id)
+                .is_some_and(|t| t.context.binding_id == c.binding_id && t.stamp != w.stamp)
+            {
+                w.valid = false;
+            }
+            Ok(serde_json::to_value(w).unwrap())
+        }
+        "status" => {
+            let r = registry().lock().unwrap();
+            Ok(r.tasks
+                .get(&c.task_id)
+                .map(status)
+                .unwrap_or(json!({ "drained": true, "revoked": true })))
+        }
+        "forget" => {
+            let mut r = registry().lock().unwrap();
+            if r.tasks
+                .get(&c.task_id)
+                .is_some_and(|t| t.context.epoch != c.epoch || t.context.binding_id != c.binding_id)
+            {
+                Err("stale_task_epoch")
+            } else if r
+                .tasks
+                .get(&c.task_id)
+                .is_some_and(|t| !t.revoked || t.in_flight != 0)
+            {
+                Err("handoff_pending")
+            } else {
+                r.tasks.remove(&c.task_id);
+                Ok(json!({ "drained": true }))
+            }
+        }
+        _ => Err("unknown_task_control"),
+    };
+    if matches!(name, "revoke" | "status") {
+        if let Ok(value) = &mut result {
+            let cursor = {
+                let r = registry().lock().unwrap();
+                r.tasks
+                    .get(&c.task_id)
+                    .filter(|t| t.revoked && t.in_flight == 0)
+                    .and_then(|t| t.cursor_id.clone())
+            };
+            if let Some(cursor) = cursor {
+                cua_driver_core::session::end_session(&cursor);
+                value["drained"] =
+                    json!(cua_driver_core::session::retry_session_cleanup(&cursor).complete);
+            }
+        }
+    }
+    match result {
+        Ok(value) => DaemonResponse::ok(value),
+        Err(error) => DaemonResponse::err(error, 77),
+    }
+}
+pub(crate) fn observe_after(permit: &Option<Permit>, result: &mut Value) {
+    let Some(permit) = permit else {
+        return;
+    };
+    let c = registry()
+        .lock()
+        .unwrap()
+        .tasks
+        .get(&permit.id)
+        .map(|t| t.context.clone());
+    if let Some(c) = c {
+        if c.mode == "background" && probe(c.pid, c.window_id, c.host_pid).foreground {
+            if let Some(task) = registry().lock().unwrap().tasks.get_mut(&permit.id) {
+                task.revoked = true;
+            }
+            if !result["structuredContent"].is_object() {
+                result["structuredContent"] = json!({});
+            }
+            result["structuredContent"]["code"] = json!("user_in_control");
+        }
+    }
+}
+pub(crate) fn note_session(permit: &Option<Permit>, session: Option<&str>) {
+    if let Some(permit) = permit {
+        if let Some(task) = registry().lock().unwrap().tasks.get_mut(&permit.id) {
+            task.cursor_id = session.map(str::to_owned);
+        }
+    }
+}
+pub(crate) struct Permit {
+    id: String,
+    _lease: tokio::sync::OwnedMutexGuard<()>,
+}
+impl Drop for Permit {
+    fn drop(&mut self) {
+        if let Some(task) = registry().lock().unwrap().tasks.get_mut(&self.id) {
+            task.in_flight = task.in_flight.saturating_sub(1);
+        }
+    }
+}
+fn refusal(code: &str) -> DaemonResponse {
+    DaemonResponse::ok(
+        json!({ "isError": true, "content": [{ "type": "text", "text": code }],
+        "structuredContent": { "code": code, "effect": "refused", "retryable": false } }),
+    )
+}
+fn policy(c: &Context, tool: &str, args: &Value) -> Result<(), &'static str> {
+    const COMMON: &[&str] = &["check_permissions", "health_report", "get_config"];
+    if COMMON.contains(&tool) {
+        return Ok(());
+    }
+    const READS: &[&str] = &["get_window_state", "verify_state", "zoom"];
+    const WRITES: &[&str] = &[
+        "click",
+        "double_click",
+        "right_click",
+        "set_value",
+        "scroll",
+        "type_text",
+        "press_key",
+        "hotkey",
+        "drag",
+    ];
+    if !READS.contains(&tool) && !WRITES.contains(&tool) {
+        return Err("scope_violation");
+    }
+    if args["pid"].as_i64() != Some(i64::from(c.pid))
+        || args["window_id"].as_u64() != Some(c.window_id)
+        || !args["target"].is_null()
+        || args["scope"] == "desktop"
+        || !args["screenshot_out_file"].is_null()
+        || !args["debug_image_out"].is_null()
+    {
+        return Err("scope_violation");
+    }
+    if c.mode == "background" && WRITES.contains(&tool) {
+        if args["delivery_mode"] == "foreground"
+            || !args["x"].is_null()
+            || !args["y"].is_null()
+            || args
+                .get("modifier")
+                .is_some_and(|v| v.as_str().is_some_and(|s| !s.is_empty()))
+            || args
+                .get("button")
+                .is_some_and(|v| v.as_str().is_some_and(|s| s != "left"))
+        {
+            return Err("foreground_required");
+        }
+        // First supported background tier is exact-element semantics. Generic keyboard,
+        // pointer and drag routes cannot establish a no-global-input guarantee for every app.
+        if WRITES.contains(&tool)
+            && (!["click", "set_value", "scroll"].contains(&tool)
+                || (args["element_index"].as_u64().is_none()
+                    && args["element_token"].as_str().is_none()))
+        {
+            return Err("background_unavailable");
+        }
+    }
+    Ok(())
+}
+/// Check again after the process lease: a revoked queued call must never enter an actuator.
+pub(crate) async fn admit(tool: &str, args: &mut Value) -> Result<Option<Permit>, DaemonResponse> {
+    let raw = args.as_object_mut().and_then(|a| a.remove("_nuwax_task"));
+    if !enabled() {
+        return if raw.is_some() {
+            Err(refusal("window_tasks_unavailable"))
+        } else {
+            Ok(None)
+        };
+    }
+    let Some(raw) = raw else {
+        if ["check_permissions", "health_report", "list_windows", "set_agent_cursor_enabled"].contains(&tool) {
+            return Ok(None);
+        }
+        return Err(refusal("task_context_required"));
+    };
+    let c = context(raw).map_err(refusal)?;
+    policy(&c, tool, args).map_err(refusal)?;
+    let mutex = {
+        let mut locks = process_locks().lock().unwrap();
+        locks.retain(|_, lock| Arc::strong_count(lock) > 1);
+        locks
+            .entry(c.pid)
+            .or_insert_with(|| Arc::new(tokio::sync::Mutex::new(())))
+            .clone()
+    };
+    let lease = mutex.lock_owned().await;
+    let w = probe(c.pid, c.window_id, c.host_pid);
+    registry().lock().unwrap().admit(&c, &w).map_err(refusal)?;
+    Ok(Some(Permit {
+        id: c.task_id,
+        _lease: lease,
+    }))
+}
