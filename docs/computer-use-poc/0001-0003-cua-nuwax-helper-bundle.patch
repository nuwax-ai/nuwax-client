+fn daemon_metadata_response(request: &DaemonRequest) -> DaemonResponse {
+    let mut metadata = serde_json::to_value(cua_driver_core::daemon::current_daemon_metadata())
+        .expect("daemon metadata is serializable");
+    if let Some(nonce) = request
+        .args
+        .as_ref()
+        .and_then(|args| args.get("nuwax_nonce"))
+        .and_then(serde_json::Value::as_str)
+    {
+        let token = match cua_driver_core::daemon::nuwax_endpoint_token() {
+            Ok(Some(token)) => token,
+            _ => return DaemonResponse::err("Nuwax endpoint capability unavailable", 77),
+        };
+        let proof = match cua_driver_core::daemon::nuwax_endpoint_proof(&token, nonce) {
+            Ok(proof) => proof,
+            Err(_) => return DaemonResponse::err("invalid Nuwax endpoint challenge", 64),
+        };
+        metadata["nuwax_endpoint_proof"] = serde_json::Value::String(proof);
+    }
+    if cfg!(any(target_os = "macos", target_os = "windows")) {
+        metadata["nuwax_window_tasks"] = serde_json::json!(1);
+        metadata["nuwax_window_preview"] = serde_json::json!(1);
+    }
+    DaemonResponse::ok(metadata)
 }
 
