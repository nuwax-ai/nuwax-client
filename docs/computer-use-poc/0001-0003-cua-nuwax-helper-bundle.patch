+fn nuwax_request_authorized(line: &str) -> bool {
+    let token = match cua_driver_core::daemon::nuwax_endpoint_token() {
+        Ok(None) => return true,
+        Ok(Some(token)) => token,
+        Err(_) => return false,
+    };
+    nuwax_request_authorized_with_token(line, &token)
+}
+
+fn nuwax_request_authorized_with_token(line: &str, token: &str) -> bool {
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(line) else {
+        return false;
+    };
+    if value["method"] == "metadata"
+        && value["args"]["nuwax_nonce"]
+            .as_str()
+            .is_some_and(|nonce| nonce.len() == 32 && nonce.bytes().all(|b| b.is_ascii_hexdigit()))
+    {
+        return true;
+    }
+    let Some(actual) = value["nuwax_client_token"].as_str() else {
+        return false;
+    };
+    actual.len() == token.len()
+        && actual
+            .bytes()
+            .zip(token.bytes())
+            .fold(0_u8, |diff, (a, b)| diff | (a ^ b))
+            == 0
+}
+
+#[cfg(test)]
+mod nuwax_endpoint_auth_tests {
+    use super::nuwax_request_authorized_with_token;
+
+    #[test]
+    fn capability_is_required_for_actions_but_not_for_a_challenge() {
+        let token = "a".repeat(64);
+        assert!(nuwax_request_authorized_with_token(
+            &format!(
+                r#"{{"method":"metadata","args":{{"nuwax_nonce":"{}"}}}}"#,
+                "b".repeat(32)
+            ),
+            &token,
+        ));
+        assert!(!nuwax_request_authorized_with_token(
+            r#"{"method":"call","name":"click"}"#,
+            &token
+        ));
+        assert!(!nuwax_request_authorized_with_token(
+            r#"{"method":"call","nuwax_client_token":"wrong"}"#,
+            &token,
+        ));
+        assert!(nuwax_request_authorized_with_token(
+            &format!(r#"{{"method":"call","nuwax_client_token":"{token}"}}"#),
+            &token,
+        ));
+    }
+}
