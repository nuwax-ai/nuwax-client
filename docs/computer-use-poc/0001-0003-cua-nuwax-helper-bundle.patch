+        let mut r = Registry::default();
+        let mut c = Context {
+            task_id: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa".into(),
+            binding_id: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb".into(),
+            epoch: 1,
+            pid: 23,
+            host_pid: 24,
+            window_id: 25,
+            mode: "background".into(),
+        };
+        let mut w = Window {
+            valid: true,
+            foreground: false,
+            visible: true,
+            stamp: "identity".into(),
+            bounds: Value::Null,
+        };
+        assert_eq!(r.validate_preview(&c, &w), Err("task_not_bound"));
+        r.bind(c.clone(), &w).unwrap();
+        let old = c.clone();
+        c.epoch += 1;
+        r.revoke(&c).unwrap();
+        assert!(r.validate_preview(&c, &w).is_ok());
+        assert_eq!(r.tasks[&c.task_id].in_flight, 0);
+        assert!(r.tasks[&c.task_id].revoked);
+        assert_eq!(r.validate_preview(&old, &w), Err("stale_task_epoch"));
+        let mut other = c.clone();
+        other.binding_id = "cccccccc-cccc-cccc-cccc-cccccccccccc".into();
+        assert_eq!(r.validate_preview(&other, &w), Err("stale_task_epoch"));
+        w.stamp = "reused-native-id".into();
+        assert_eq!(r.validate_preview(&c, &w), Err("target_identity_changed"));
+    }
+}
