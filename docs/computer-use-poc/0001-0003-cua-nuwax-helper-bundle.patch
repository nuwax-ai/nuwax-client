+        let token = match cua_driver_core::daemon::nuwax_endpoint_token() {
+            Ok(Some(token)) => token,
+            _ => return DaemonResponse::err("Nuwax endpoint capability unavailable", 77),
+        };
+        let proof = match cua_driver_core::daemon::nuwax_endpoint_proof(&token, nonce) {
+            Ok(proof) => proof,
+            Err(_) => return DaemonResponse::err("invalid Nuwax endpoint challenge", 64),
+        };
+        metadata["nuwax_endpoint_proof"] = serde_json::Value::String(proof);
+    }
+    DaemonResponse::ok(metadata)
 }

