+fn open_permission_request_result(path: &std::path::Path) -> std::io::Result<std::fs::File> {
+    use std::os::unix::fs::{MetadataExt as _, OpenOptionsExt as _};
+
+    // The caller creates this private file before LaunchServices dispatch. Cancel
+    // unlinks it before killing the exact host, so a late host must fail here
+    // before any system permission request. Keep the validated handle for output.
+    let file = std::fs::OpenOptions::new()
+        .write(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file()
+        || metadata.uid() != unsafe { libc::geteuid() }
+        || metadata.mode() & 0o777 != 0o600
+        || metadata.nlink() != 1
+    {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "permission request result must be a private regular file owned by the current user",
+        ));
+    }
+    Ok(file)
+}
