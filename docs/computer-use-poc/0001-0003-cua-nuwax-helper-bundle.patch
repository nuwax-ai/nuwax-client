+#[cfg(target_os = "macos")]
+fn mac_window_identity(pid: i32, wid: u32) -> Option<String> {
+    use platform_macos::ax::bindings::{
+        ax_get_window_id, copy_ax_windows, AXUIElementCreateApplication,
+    };
+    use std::ffi::c_void;
+    #[link(name = "CoreFoundation", kind = "framework")]
+    extern "C" {
+        fn CFRelease(value: *const c_void);
+        fn CFEqual(a: *const c_void, b: *const c_void) -> u8;
+    }
+    // Retain the AX identity, not a title or geometry: both may change during a task.
+    // usize stores an opaque retained CF reference; it is only used under this mutex.
+    struct Identity {
+        element: usize,
+        stamp: String,
+    }
+    impl Drop for Identity {
+        fn drop(&mut self) {
+            unsafe {
+                CFRelease(self.element as *const c_void);
+            }
+        }
+    }
+    static IDENTITIES: OnceLock<Mutex<HashMap<(i32, u32), Identity>>> = OnceLock::new();
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if app.is_null() {
+            return None;
+        }
+        let windows = copy_ax_windows(app);
+        CFRelease(app.cast());
+        let mut selected = None;
+        for element in windows {
+            if selected.is_none() && ax_get_window_id(element) == Some(wid) {
+                selected = Some(element);
+            } else {
+                CFRelease(element.cast());
+            }
+        }
+        let element = selected?;
+        let mut identities = IDENTITIES
+            .get_or_init(|| Mutex::new(HashMap::new()))
+            .lock()
+            .unwrap();
+        let key = (pid, wid);
+        if let Some(old) = identities.get(&key) {
+            if CFEqual(old.element as *const c_void, element.cast()) != 0 {
+                CFRelease(element.cast());
+                return Some(old.stamp.clone());
+            }
+        } else if identities.len() >= 512 {
+            CFRelease(element.cast());
+            return None;
+        }
+        let stamp = uuid::Uuid::new_v4().to_string();
+        identities.insert(
+            key,
+            Identity {
+                element: element as usize,
+                stamp: stamp.clone(),
+            },
+        );
+        Some(stamp)
+    }
+}
+#[cfg(target_os = "macos")]
+fn probe(pid: i32, wid: u64, host_pid: i32) -> Window {
+    let Ok(wid) = u32::try_from(wid) else {
+        return unavailable();
+    };
+    let Some(w) = platform_macos::windows::window_info_by_id(wid).filter(|w| w.pid == pid) else {
+        return unavailable();
+    };
+    let Some(identity) = mac_window_identity(pid, wid) else {
+        return unavailable();
+    };
+    let stamp = unsafe {
+        let mut info: libc::proc_bsdinfo = std::mem::zeroed();
+        let size = std::mem::size_of::<libc::proc_bsdinfo>() as i32;
+        if libc::proc_pidinfo(
+            pid,
+            libc::PROC_PIDTBSDINFO,
+            0,
+            &mut info as *mut _ as *mut libc::c_void,
+            size,
+        ) != size
+        {
+            return unavailable();
+        }
+        format!(
+            "{}:{}:{}",
+            info.pbi_start_tvsec, info.pbi_start_tvusec, identity
+        )
+    };
+    let foreground = platform_macos::apps::frontmost_pid() == Some(pid)
+        && platform_macos::ax::bindings::focused_window_id_of_pid(pid).map_or(true, |id| id == wid);
+    let top = platform_macos::windows::nuwax_visible_windows_any_layer()
+        .into_iter()
+        .find(|other| {
+            other.pid != std::process::id() as i32
+                && !(other.pid == host_pid && other.title == "Nuwax Computer Use Badge")
+                && other.bounds.x < w.bounds.x + w.bounds.width
+                && other.bounds.x + other.bounds.width > w.bounds.x
+                && other.bounds.y < w.bounds.y + w.bounds.height
+                && other.bounds.y + other.bounds.height > w.bounds.y
+        });
+    Window {
+        valid: true,
+        foreground,
+        visible: w.is_on_screen && top.is_some_and(|top| top.window_id == wid),
+        stamp,
+        bounds: json!({ "x": w.bounds.x, "y": w.bounds.y, "width": w.bounds.width, "height": w.bounds.height }),
+    }
+}
+#[cfg(target_os = "windows")]
+fn probe(pid: i32, wid: u64, host_pid: i32) -> Window {
+    use windows::core::w;
+    use windows::Win32::Foundation::{CloseHandle, FILETIME, HANDLE, HWND, RECT};
+    use windows::Win32::System::Threading::{
+        GetProcessTimes, OpenProcess, PROCESS_QUERY_LIMITED_INFORMATION,
+    };
+    use windows::Win32::UI::WindowsAndMessaging::{
+        GetForegroundWindow, GetPropW, GetTopWindow, GetWindow, GetWindowRect, GetWindowTextW,
+        GetWindowThreadProcessId, IsIconic, IsWindow, IsWindowVisible, SetPropW, GW_HWNDNEXT,
+    };
+    let hwnd = HWND(wid as usize as *mut _);
+    unsafe {
+        if !IsWindow(Some(hwnd)).as_bool() {
+            return unavailable();
+        }
+        let mut owner = 0;
+        GetWindowThreadProcessId(hwnd, Some(&mut owner));
+        if owner != pid as u32 {
+            return unavailable();
+        }
+        let Ok(handle) = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, owner) else {
+            return unavailable();
+        };
+        let (mut created, mut exited, mut kernel, mut user) = (
+            FILETIME::default(),
+            FILETIME::default(),
+            FILETIME::default(),
+            FILETIME::default(),
+        );
+        let result = GetProcessTimes(handle, &mut created, &mut exited, &mut kernel, &mut user);
+        let _ = CloseHandle(handle);
+        if result.is_err() {
+            return unavailable();
+        }
+        // Window properties are destroyed with the HWND; reuse in the same process cannot inherit this identity.
+        let key = w!("NuwaxComputerUse.WindowIdentity.v1");
+        let mut identity = GetPropW(hwnd, key);
+        if identity.is_invalid() {
+            let bytes = *uuid::Uuid::new_v4().as_bytes();
+            let value = ((u64::from_le_bytes(bytes[..8].try_into().unwrap()) as usize
+                & isize::MAX as usize)
+                | 1) as *mut _;
+            if SetPropW(hwnd, key, Some(HANDLE(value))).is_err() {
+                return unavailable();
+            }
+            identity = GetPropW(hwnd, key);
+        }
+        let mut rect = RECT::default();
+        if GetWindowRect(hwnd, &mut rect).is_err() {
+            return unavailable();
+        }
+        let mut top = HWND::default();
+        let mut candidate = GetTopWindow(None).unwrap_or_default();
+        for _ in 0..512 {
+            if candidate.is_invalid() {
+                break;
+            }
+            let mut candidate_pid = 0;
+            GetWindowThreadProcessId(candidate, Some(&mut candidate_pid));
+            let mut other = RECT::default();
+            let mut title = [0_u16; 128];
+            let title_len = GetWindowTextW(candidate, &mut title) as usize;
+            let badge = candidate_pid == host_pid as u32
+                && String::from_utf16_lossy(&title[..title_len]) == "Nuwax Computer Use Badge";
+            if !badge
+                && candidate_pid != std::process::id()
+                && IsWindowVisible(candidate).as_bool()
+                && !IsIconic(candidate).as_bool()
+                && GetWindowRect(candidate, &mut other).is_ok()
+                && other.left < rect.right
+                && other.right > rect.left
+                && other.top < rect.bottom
+                && other.bottom > rect.top
+            {
+                top = candidate;
+                break;
+            }
+            candidate = GetWindow(candidate, GW_HWNDNEXT).unwrap_or_default();
+        }
+        Window {
+            valid: true,
+            foreground: GetForegroundWindow() == hwnd,
+            visible: IsWindowVisible(hwnd).as_bool() && !IsIconic(hwnd).as_bool() && top == hwnd,
+            stamp: format!(
+                "{}:{}:{}",
+                created.dwHighDateTime, created.dwLowDateTime, identity.0 as usize
+            ),
+            bounds: json!({ "x": rect.left, "y": rect.top, "width": rect.right - rect.left, "height": rect.bottom - rect.top }),
+        }
+    }
+}
+#[cfg(not(any(target_os = "macos", target_os = "windows")))]
+fn probe(_: i32, _: u64, _: i32) -> Window {
+    unavailable()
+}
