+/// Nuwax's standalone helper is reachable only through a per-installation
+/// private endpoint. This capability is shared with its MCP proxy through a
+/// mode-0600 file, never through the persisted MCP configuration itself.
+pub const NUWAX_TOKEN_FILE_ENV: &str = "CUA_DRIVER_NUWAX_TOKEN_FILE";
+
+pub fn nuwax_endpoint_token() -> anyhow::Result<Option<String>> {
+    let Some(file) = std::env::var_os(NUWAX_TOKEN_FILE_ENV) else {
+        return Ok(None);
+    };
+    let token = std::fs::read_to_string(file)?.trim().to_owned();
+    anyhow::ensure!(
+        token.len() == 64 && token.bytes().all(|b| b.is_ascii_hexdigit()),
+        "invalid Nuwax endpoint capability"
+    );
+    Ok(Some(token))
+}
+
+pub fn nuwax_endpoint_proof(token: &str, nonce: &str) -> anyhow::Result<String> {
+    use hmac::{Hmac, Mac};
+    use sha2::Sha256;
+    anyhow::ensure!(
+        nonce.len() == 32 && nonce.bytes().all(|b| b.is_ascii_hexdigit()),
+        "invalid Nuwax endpoint challenge"
+    );
+    let mut mac = Hmac::<Sha256>::new_from_slice(token.as_bytes())?;
+    mac.update(nonce.as_bytes());
+    Ok(mac
+        .finalize()
+        .into_bytes()
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect())
+}
+
+pub fn nuwax_request_line(request: &DaemonRequest, token: Option<&str>) -> anyhow::Result<String> {
+    let mut value = serde_json::to_value(request)?;
+    if let Some(token) = token {
+        value["nuwax_client_token"] = serde_json::Value::String(token.to_owned());
+    }
+    Ok(serde_json::to_string(&value)? + "\n")
+}
+
+fn nuwax_verify_metadata_proof(
+    response: &DaemonResponse,
+    token: &str,
+    nonce: &str,
+) -> anyhow::Result<()> {
+    let expected = nuwax_endpoint_proof(token, nonce)?;
+    let actual = response
+        .result
+        .as_ref()
+        .and_then(|value| value.get("nuwax_endpoint_proof"))
+        .and_then(serde_json::Value::as_str)
+        .unwrap_or("");
+    anyhow::ensure!(
+        response.ok
+            && actual.len() == expected.len()
+            && actual
+                .bytes()
+                .zip(expected.bytes())
+                .fold(0_u8, |diff, (a, b)| diff | (a ^ b))
+                == 0,
+        "Nuwax daemon endpoint proof failed"
+    );
+    Ok(())
+}
