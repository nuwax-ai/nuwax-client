+/// Nuwax: embedding hosts ship the driver inside their own LSUIElement helper
+/// bundle (e.g. "Nuwax Computer Use.app"). Such a bundle carries the same
+/// stable TCC responsibility identity as CuaDriver.app, so the
+/// responsibility-disclaim re-exec must be skipped for it as well or actions
+/// silently lose the host bundle's TCC grants. Additional bundle directory
+/// names may be declared via `CUA_DRIVER_BUNDLE_DIR_NAMES` (comma separated,
+/// e.g. "My Helper.app,Other.app").
+#[cfg(target_os = "macos")]
+fn inside_stable_bundle_dir(path: &str) -> bool {
+    const MACOS_SUFFIX: &str = "/Contents/MacOS/";
+    const KNOWN_BUNDLE_DIRS: &[&str] = &[
+        "CuaDriver.app",
+        "CuaDriverLocal.app",
+        "Nuwax Computer Use.app",
+        "NuwaClaw Computer Use.app",
+    ];
+    let extras = std::env::var("CUA_DRIVER_BUNDLE_DIR_NAMES")
+        .map(|value| {
+            value
+                .split(',')
+                .map(|name| name.trim().to_string())
+                .filter(|name| !name.is_empty())
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    KNOWN_BUNDLE_DIRS
+        .iter()
+        .copied()
+        .chain(extras.iter().map(|name| name.as_str()))
+        .any(|dir| path.contains(&format!("/{dir}{MACOS_SUFFIX}")))
+}
+
 /// Returns `true` when the env var is one of `1|true|yes|on`
 /// (case-insensitive). Anything else, including unset, is falsy.
 #[cfg(target_os = "windows")]
