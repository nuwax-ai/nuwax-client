+// Host display reads deliberately do not grant action permits or model observation credit.
+fn preview_context(args: Value) -> Result<Context, &'static str> {
+    let c = context(args)?;
+    let w = probe(c.pid, c.window_id, c.host_pid);
+    let r = registry().lock().unwrap();
+    r.validate_preview(&c, &w)?;
+    Ok(c)
+}
+impl Registry {
+    fn validate_preview(&self, c: &Context, w: &Window) -> Result<(), &'static str> {
+        let t = self.tasks.get(&c.task_id).ok_or("task_not_bound")?;
+        if t.context.task_id != c.task_id
+            || t.context.binding_id != c.binding_id
+            || t.context.epoch != c.epoch
+            || t.context.pid != c.pid
+            || t.context.window_id != c.window_id
+            || t.context.host_pid != c.host_pid
+        {
+            return Err("stale_task_epoch");
+        }
+        if !w.valid || t.stamp != w.stamp {
+            return Err("target_identity_changed");
+        }
+        Ok(())
+    }
+}
+fn preview_capture(c: &Context) -> Result<Value, &'static str> {
+    use base64::Engine;
+    #[cfg(target_os = "macos")]
+    let png = platform_macos::capture::nuwax_preview_window(c.window_id as u32);
+    #[cfg(target_os = "windows")]
+    let png = platform_windows::capture::nuwax_preview_window(c.window_id);
+    #[cfg(not(any(target_os = "macos", target_os = "windows")))]
+    let png: anyhow::Result<Vec<u8>> = Err(anyhow::anyhow!("unsupported"));
+    let png = png.map_err(|e| {
+        if e.to_string().contains("minimized") {
+            "preview_minimized"
+        } else {
+            "preview_unavailable"
+        }
+    })?;
+    let img = image::load_from_memory(&png)
+        .map_err(|_| "preview_unavailable")?
+        .thumbnail(960, 960)
+        .to_rgb8();
+    let mut bytes = Vec::new();
+    image::codecs::jpeg::JpegEncoder::new_with_quality(&mut bytes, 70)
+        .encode_image(&img)
+        .map_err(|_| "preview_unavailable")?;
+    if bytes.len() > 512 * 1024 {
+        return Err("preview_oversize");
+    }
+    preview_context(serde_json::to_value(c).unwrap())?;
+    Ok(
+        json!({"task_id": c.task_id, "binding_id": c.binding_id, "epoch": c.epoch,
+        "width": img.width(), "height": img.height(), "jpeg": base64::engine::general_purpose::STANDARD.encode(bytes)}),
+    )
+}
+/// Called only by the authenticated host endpoint, never listed as a model tool.
+pub(crate) async fn host_command(
+    sdk: std::sync::Arc<crate::sdk_adapter::SdkAdapter>,
+    req: DaemonRequest,
+) -> DaemonResponse {
+    if !enabled() {
+        return DaemonResponse::err("window_tasks_unavailable", 77);
+    }
+    let c = match preview_context(req.args.unwrap_or(Value::Null)) {
+        Ok(c) => c,
+        Err(e) => return DaemonResponse::err(e, 77),
+    };
+    if req.name.as_deref() == Some("preview") {
+        static CAPTURE: OnceLock<Arc<tokio::sync::Semaphore>> = OnceLock::new();
+        let gate = CAPTURE
+            .get_or_init(|| Arc::new(tokio::sync::Semaphore::new(1)))
+            .clone();
+        let Ok(permit) = gate.try_acquire_owned() else {
+            return DaemonResponse::err("preview_busy", 77);
+        };
+        let result = tokio::task::spawn_blocking(move || {
+            let _permit = permit;
+            preview_capture(&c)
+        })
+        .await;
+        return match result {
+            Ok(Ok(v)) => DaemonResponse::ok(v),
+            Ok(Err(e)) => DaemonResponse::err(e, 77),
+            Err(_) => DaemonResponse::err("preview_unavailable", 77),
+        };
+    }
+    if req.name.as_deref() != Some("takeover") {
+        return DaemonResponse::err("unknown_task_control", 64);
+    }
+    {
+        let r = registry().lock().unwrap();
+        let Some(t) = r.tasks.get(&c.task_id) else {
+            return DaemonResponse::err("task_not_bound", 77);
+        };
+        if !t.revoked || t.in_flight != 0 {
+            return DaemonResponse::err("handoff_pending", 77);
+        }
+    }
+    let result = sdk
+        .invoke_raw(
+            "bring_to_front",
+            json!({"pid": c.pid, "window_id": c.window_id}),
+        )
+        .await;
+    let valid = preview_context(serde_json::to_value(&c).unwrap()).is_ok();
+    let focused = probe(c.pid, c.window_id, c.host_pid).foreground;
+    if result.is_ok_and(|v| v["isError"] != true) && valid && focused {
+        DaemonResponse::ok(json!({"activated": true}))
+    } else {
+        DaemonResponse::err("target_activation_failed", 77)
+    }
+}
