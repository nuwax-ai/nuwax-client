 }
 
 pub fn app_bundle_path() -> String {
+    if let Some(path) = current_running_bundle_path() {
+        return path;
+    }
     format!("/Applications/{}.app", app_name())
 }
 
+/// Nuwax: when the driver runs inside a host helper bundle, relaunch and
+/// permission-host flows must target that bundle (its TCC identity), not the
+/// upstream CuaDriver.app in /Applications.
+#[cfg(target_os = "macos")]
+fn current_running_bundle_path() -> Option<String> {
+    let exe = std::env::current_exe().ok()?.canonicalize().ok()?;
+    let path = exe.to_str()?;
+    if !inside_stable_bundle_dir(path) {
+        return None;
+    }
+    let idx = path.find("/Contents/MacOS/")?;
+    Some(path[..idx].to_string())
+}
+
+#[cfg(not(target_os = "macos"))]
+fn current_running_bundle_path() -> Option<String> {
+    None
+}
